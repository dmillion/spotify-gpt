# Spotify Developer Dashboard -> your app -> Client ID
SPOTIFY_CLIENT_ID='API_KEY_HERE'

# Last.fm API credentials used for artist genre/tag metadata.
# Read-only tag lookups only require LASTFM_API_KEY; keep the shared secret server-side.
LASTFM_API_KEY='API_KEY_HERE'
LASTFM_SHARED_SECRET='SHARED_SECRET_HERE'

# Ollama configuration.
#
# CLOUD EXAMPLE — uses your Ollama account/API allowance:
OLLAMA_API_KEY='API_KEY_HERE'
OLLAMA_MODEL='qwen3.5:cloud'
OLLAMA_API_URL='https://ollama.com/api/chat'
#
# LOCAL EXAMPLE — uncomment these three lines instead after installing/pulling a local model.
# The local Ollama server does not require a real API key; the app currently expects the
# variable to exist, so any non-empty placeholder is sufficient.
# OLLAMA_API_KEY='local'
# OLLAMA_MODEL='qwen3.5:27b'
# OLLAMA_API_URL='http://127.0.0.1:11434/api/chat'
#
# Maximum time, in seconds, to wait for each Ollama inference request. Hybrid playlist
# generation makes two model calls, and larger local models can take several minutes.
OLLAMA_TIMEOUT=300
# Disable extended reasoning for structured retrieval/curation by default. Set true,
# low, medium, or high only if the selected Ollama model supports and benefits from it.
OLLAMA_THINK=false
# Keep the final curator prompt bounded for local inference. Defaults are tuned for
# a 20-track playlist while leaving enough alternatives for sequencing and diversity.
OLLAMA_LOCAL_CANDIDATE_LIMIT=60
OLLAMA_EXTERNAL_CANDIDATE_LIMIT=20
PLAYLIST_TRACK_LIMIT=20
PLAYLIST_ARTIST_LIMIT=2
#
# To switch providers, change the active three OLLAMA_* values and restart python app.py.

# Optional shared-password gate for exposing the local Flask app to a few testers.
# Leave APP_PASSWORD unset to keep local development ungated.
APP_PASSWORD='CHOOSE_A_LONG_SHARED_PASSWORD'
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SESSION_SECRET='GENERATE_A_RANDOM_SECRET_HERE'
# Set to 1 when the app is only being accessed over HTTPS, such as a Cloudflare tunnel.
APP_SESSION_COOKIE_SECURE=0

# Add this exact URI to the app's Redirect URIs in the Spotify dashboard.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
