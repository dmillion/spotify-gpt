# Spotify Developer Dashboard -> your app -> Client ID
SPOTIFY_CLIENT_ID='API_KEY_HERE'

# OpenAI API key used to turn natural-language prompts into track lists.
OPENAI_API_KEY='API_KEY_HERE'
# Optional: defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Add this exact URI to the app's Redirect URIs in the Spotify dashboard.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
